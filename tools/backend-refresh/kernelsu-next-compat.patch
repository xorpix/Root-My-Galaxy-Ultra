+rmgu_phase=
+rmgu_recorded_key=
+rmgu_armed_second=
+rmgu_uptime_second=
+rmgu_read_uptime() {
+    read -r rmgu_uptime rmgu_idle < /proc/uptime || return 1
+    rmgu_uptime_second=${rmgu_uptime%%.*}
+    case "$rmgu_uptime_second" in ''|*[!0-9]*) return 1 ;; esac
