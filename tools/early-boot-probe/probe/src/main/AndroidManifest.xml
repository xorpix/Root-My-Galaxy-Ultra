<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <permission android:name="dev.experimental.rmgu.bootprobe.permission.HELPER" android:protectionLevel="signature" />
    <uses-permission android:name="dev.experimental.rmgu.bootprobe.permission.HELPER" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <queries><package android:name="dev.experimental.rmgu.boothelper" /></queries>
    <application android:label="RMGU Boot Probe" android:icon="@drawable/probe_icon" android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <provider android:name=".HelperApkProvider" android:exported="false"
            android:authorities="dev.experimental.rmgu.bootprobe.helper-apk" android:grantUriPermissions="true" />
        <provider android:name=".ReportProvider" android:exported="false"
            android:authorities="dev.experimental.rmgu.bootprobe.reports" android:grantUriPermissions="true" />
    </application>
</manifest>
