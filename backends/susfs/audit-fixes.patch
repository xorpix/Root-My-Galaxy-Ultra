+ lines.append(f'static_assert({num} == __NR_compat32_{name.lower()});')
+lines.append('MODULE_LICENSE("GPL");')
+(fixture/'fixture.c').write_text('\n'.join(lines)+'\n');(fixture/'Makefile').write_text('obj-m := fixture.o\n')
+env=dict(os.environ);env['PATH']=str(a.clang_bin.resolve())+os.pathsep+env['PATH']
+with (out/'fixture-build.log').open('w') as log:
+ subprocess.run(['make','-C',str(a.kdir.resolve()),f'M={fixture}','ARCH=arm64','CC=clang','LLVM=1','LLVM_IAS=1','CONFIG_DEBUG_INFO_BTF_MODULES=','modules','-j2'],env=env,stdout=log,stderr=subprocess.STDOUT,check=True)
+before=inspect(a.baseline);candidate=inspect(a.candidate);expected=inspect(fixture/'fixture.ko')
+wrappers=sorted(n for n in candidate['functions'] if n.startswith(('create_wrap_','or_wrap_')))
+words={n:candidate['types'].get(n) for n in wrappers};expected_word=expected['types']['expected_syscall']
