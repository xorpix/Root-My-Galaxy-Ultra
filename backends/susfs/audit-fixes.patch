+a=p.parse_args();out=a.output.resolve();out.mkdir(parents=True,exist_ok=True);root=Path(__file__).resolve().parents[1]
+fixture=out/'syscall-fixture';fixture.mkdir(exist_ok=True)
+lines=['#include <linux/module.h>','#include <asm/syscall.h>','#include <asm/unistd_compat_32.h>',f'#include "{root / "kernel/susfs_fp_hook.h"}"',
+ 'static __used long expected_syscall(const struct pt_regs *regs) { return 0; }',
+ 'static syscall_fn_t expected_pointer __used = expected_syscall;',
