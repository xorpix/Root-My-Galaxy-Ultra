diff --git a/kernel/susfs_priority_filter.c b/kernel/susfs_priority_filter.c
index 8df2a2a..95d524d 100644
--- a/kernel/susfs_priority_filter.c
+++ b/kernel/susfs_priority_filter.c
@@ -5,8 +5,9 @@
  *
  * Configuration is transactional and uses the root caller's existing credentials.
  * No credential/security blob is edited, and no path, mount or cred is retained.
- * Native and compat entries have separate originals and complete FP lifetimes.
- * All entries must install before this optional feature accepts configuration.
+ * Native and compat table entries have separate originals and complete lifetimes.
+ * A refused write can use verified shared entry probes, also with full draining.
+ * Complete coverage must install before this optional feature accepts configuration.
  * Empty configuration is the default; the priority fast path never allocates.
  */
 #include <linux/module.h>
@@ -25,12 +26,14 @@
 #include <linux/uaccess.h>
 #include <linux/resource.h>
 #include <linux/ioprio.h>
+#include <linux/kprobes.h>
 #include <asm/unistd.h>
 #include <asm/ptrace.h>
 
 #include "susfs.h"
 #include "susfs_abi.h"
 #include "susfs_fp_hook.h"
+#include "susfs_kprobe.h"
 #include "symbol_resolver.h"
 #include "ksu_umount_gate.h"
 
@@ -67,13 +70,17 @@ static_assert(__same_type(typeof(prio_check_cap_fn), typeof(&ioprio_check_cap)))
 static struct susfs_fp_hook prio_hooks[PRIO_OP_COUNT];
 /* Retain the first initialization failure after rollback. Some production
  * kernels expose no usable printk history; do not make recovery depend on it.
- * stage: 0=ready, 1=I/O validation helper, 2=hook installation, 3=compat coverage.
+ * stage: 0=ready, 1=I/O helper, 2=table install, 3=compat coverage, 4=probe fallback.
  * These fields are boot-local and read-only through the existing root status.
  */
 static int prio_init_errno, prio_init_stage, prio_init_op = -1;
 static unsigned int prio_init_native_mask, prio_init_compat_mask;
 static bool prio_init_compat_table;
 static u32 prio_init_native_insn, prio_init_compat_insn;
+/* 0=off, 1=syscall tables, 2=entry probes. The original table error remains
+ * visible even when the supported probe route succeeds. */
+static unsigned int prio_route, prio_probe_mask;
+static int prio_table_errno;
 
 static void prio_record_init(int error, int stage, int operation)
 {
@@ -133,26 +140,37 @@ static bool prio_should_hide_user(int which, int who, int user_class)
     return hidden;
 }
 
-static __nocfi noinline long prio_dispatch(const struct pt_regs *regs,
-                                          susfs_syscall_fn_t original,
-                                          enum prio_operation operation)
+static __nocfi noinline bool prio_filter_result(const struct pt_regs *regs,
+                               enum prio_operation operation, long *result)
 {
     int user_class = operation == PRIO_IOGET || operation == PRIO_IOSET ?
         IOPRIO_WHO_USER : PRIO_USER;
     int rc;
 
-    if (!original)
-        return -ENOSYS;
     if (!prio_should_hide_user((int)regs->regs[0], (int)regs->regs[1], user_class))
-        return original(regs);
+        return false;
     if (operation == PRIO_IOSET) {
         /* Linux validates the priority/capabilities BEFORE looking up a UID.
          * Keep those errors; returning ESRCH first creates a new detection signal. */
         rc = prio_check_cap_fn((int)regs->regs[2]);
-        if (rc)
-            return rc;
+        if (rc) {
+            *result = rc;
+            return true;
+        }
     }
-    return -ESRCH;
+    *result = -ESRCH;
+    return true;
+}
+
+static __nocfi noinline long prio_dispatch(const struct pt_regs *regs,
+                                          susfs_syscall_fn_t original,
+                                          enum prio_operation operation)
+{
+    long result;
+
+    if (!original)
+        return -ENOSYS;
+    return prio_filter_result(regs, operation, &result) ? result : original(regs);
 }
 
 #define PRIO_WRAPPER(name, slot, operation) \
@@ -192,6 +210,140 @@ static struct susfs_fp_hook prio_hooks[PRIO_OP_COUNT] = {
       .compat_wrapper = prio_wrap_compat_ioprio_set, .orig_slot_compat = &prio_orig_compat_ioprio_set },
 };
 
+/* Samsung RKP can refuse the data-only table write. Use the kernel's supported
+ * probe mechanism only after that exact failure and verified table restoration.
+ * The handler never calls an original syscall or sleeps: it either leaves the
+ * complete frame alone or returns the same filtered result before PAC executes.
+ */
+static int prio_probe_pre(struct pt_regs *regs, enum prio_operation operation)
+{
