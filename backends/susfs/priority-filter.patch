+    assert(!apply("com.hidden"));as_app(10002);assert(call(PRIO_GET,false,PRIO_USER,10001,0)==-ESRCH);
+    as_root();assert(!apply(""));as_app(10002);assert(call(PRIO_GET,false,PRIO_USER,10001,0)==110);
+    assert(call(PRIO_GET,false,PRIO_USER,10007,0)==-ESRCH);
+    as_root();root_policy_available=false;assert(automatic(1,10009)==-EOPNOTSUPP);root_policy_available=true;
+    assert(!automatic(0,0));assert(!prio_enabled);as_app(10002);assert(call(PRIO_GET,false,PRIO_USER,10007,0)==110);
+    finish();as_root();assert(automatic(1,10006)==-ENODEV);assert(!atomic_load(&allocations));
+}
+
+static void test_validation(void) {
+    init_ok();assert(!apply("com.hidden"));as_app(10002);
+    for(int compat=0;compat<2;compat++) {
+        validation_error=-EINVAL;assert(call(PRIO_IOSET,compat,IOPRIO_WHO_USER,10001,-1)==-EINVAL);
+        validation_error=-EPERM;assert(call(PRIO_IOSET,compat,IOPRIO_WHO_USER,10001,1)==-EPERM);
+        validation_error=0;assert(call(PRIO_IOSET,compat,IOPRIO_WHO_USER,10001,0)==-ESRCH);
+        assert(call(PRIO_IOGET,compat,IOPRIO_WHO_USER,10001,0)==-ESRCH);
+    }
+    assert(validation_calls==6);finish();
+}
+
+static void test_boot_automatic(void) {
+    as_root();prio_boot_auto=true;prio_boot_appid=10006;
+    assert(priority_auto_root_permissions==0400&&priority_appid_permissions==0400);
+    assert(!susfs_priority_filter_init());assert(prio_ready&&prio_enabled);as_app(10002);
+    assert(call(PRIO_GET,false,PRIO_USER,10006,0)==-ESRCH);finish();
+    as_root();prio_boot_appid=9999;assert(!susfs_priority_filter_init());assert(prio_ready&&!prio_enabled);finish();
+    prio_boot_appid=10006;root_policy_available=false;assert(!susfs_priority_filter_init());assert(prio_ready&&!prio_enabled);finish();
+    root_policy_available=true;prio_boot_auto=false;
+}
+
+static void test_initialization(void) {
+    char report[PAGE_SIZE];
+    as_root();helper_available=false;assert(susfs_priority_filter_init()==-EOPNOTSUPP);
+    assert(prio_init_errno==-EOPNOTSUPP&&prio_init_stage==1&&prio_init_op==-1);
+    helper_available=true;finish();
+    assert(prio_init_errno==-EOPNOTSUPP&&prio_init_stage==1);
+    for(int i=0;i<PRIO_OP_COUNT;i++){
+        install_fail=i;install_calls=0;assert(susfs_priority_filter_init()==-EIO);finish();
+        assert(prio_init_errno==-EIO&&prio_init_stage==2&&prio_init_op==i);
+        assert(prio_status_show(report,NULL)>0);
+        assert(strstr(report,"ready=0 ")&&strstr(report,"init_errno=-5 stage=2 "));
+        assert(strstr(report,"compat_table=1 ")&&strlen(report)<512);
+    }
