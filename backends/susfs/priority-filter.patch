+    int rc=susfs_priority_filter_init();assert(rc==(CONFIG_COMPAT?-EOPNOTSUPP:0));
+    if(CONFIG_COMPAT)assert(prio_init_errno==-EOPNOTSUPP&&prio_init_stage==3&&prio_init_op==0&&!prio_init_compat_table);
+    finish();compat_available=true;
+    for(int i=0;i<20;i++){
+        init_ok();assert(!prio_init_errno&&!prio_init_stage&&prio_init_op==-1);
+        assert(!apply("com.hidden"));finish();
+    }
