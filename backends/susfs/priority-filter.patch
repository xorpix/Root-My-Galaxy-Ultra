+}
+
+static void *sleeper(void *arg) {unsigned int op=(uintptr_t)arg;as_app(10002);call(op,false,0,0,0);return NULL;}
+static void *exiter(void *arg) {(void)arg;as_root();susfs_priority_filter_exit();atomic_store(&exit_finished,true);return NULL;}
+static void test_sleeping_teardown(void) {
+    pthread_t worker,exit_thread;init_ok();assert(!apply("com.hidden"));atomic_store(&sleep_original,true);
+    pthread_create(&worker,NULL,sleeper,(void *)(uintptr_t)PRIO_GET);
+    while(!atomic_load(&original_entered))sched_yield();
+    pthread_create(&exit_thread,NULL,exiter,NULL);usleep(20000);assert(!atomic_load(&exit_finished));
+    atomic_store(&release_original,true);pthread_join(worker,NULL);pthread_join(exit_thread,NULL);finish();
+}
+
+static atomic_bool run_readers;
+static void *reader(void *arg) {
+    (void)arg;as_app(10002);while(atomic_load(&run_readers)) {
+        long r=call(PRIO_GET,false,PRIO_USER,10001,0);assert(r==-ESRCH||r==110);
+    }return NULL;
+}
+static void *writer(void *arg) {
+    (void)arg;as_root();for(int i=0;i<1000;i++)assert(!apply(i&1?"com.hidden":"com.second"));return NULL;
+}
+static void *auto_writer(void *arg) {
+    (void)arg;as_root();for(int i=0;i<1000;i++)assert(!automatic(i&1,(i&1)?10006:0));return NULL;
+}
+static void test_concurrency(void) {
+    pthread_t r[2],w[2],a;init_ok();atomic_store(&run_readers,true);
+    for(int i=0;i<2;i++){pthread_create(&r[i],NULL,reader,NULL);pthread_create(&w[i],NULL,writer,NULL);}
+    pthread_create(&a,NULL,auto_writer,NULL);
+    for(int i=0;i<2;i++)pthread_join(w[i],NULL);pthread_join(a,NULL);atomic_store(&run_readers,false);
+    for(int i=0;i<2;i++)pthread_join(r[i],NULL);assert(prio_generation>=2000);finish();
+}
+
+int main(int argc,char **argv) {
+    assert(argc==2);alarm(30);
+    _Static_assert(sizeof(struct st_susfs_priority_uid_filter)==65540,"priority payload size");
+    _Static_assert(offsetof(struct st_susfs_priority_uid_filter,err)==65536,"priority result offset");
+    if(!strcmp(argv[1],"configuration"))test_configuration();
+    else if(!strcmp(argv[1],"abi-faults"))test_abi_faults();
+    else if(!strcmp(argv[1],"queries"))test_queries();
+    else if(!strcmp(argv[1],"automatic"))test_automatic();
+    else if(!strcmp(argv[1],"boot-automatic"))test_boot_automatic();
+    else if(!strcmp(argv[1],"validation"))test_validation();
+    else if(!strcmp(argv[1],"initialization"))test_initialization();
+    else if(!strcmp(argv[1],"sleeping-teardown"))test_sleeping_teardown();
+    else if(!strcmp(argv[1],"concurrency"))test_concurrency();
+    else abort();
+    puts("PASS priority filter case");return 0;
+}
