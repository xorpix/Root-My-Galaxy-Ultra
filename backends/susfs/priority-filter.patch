+static const char *test_case;
+static int unhandled,command_error;
+sysarg priority_sys6(sysarg n,sysarg a,sysarg b,sysarg c,sysarg d,sysarg e,sysarg f) {
+    (void)e;(void)f;
+    if(n==64){assert(a==1&&captured_len+(usize)c<sizeof(captured));long amount=c>17?17:c;memcpy(captured+captured_len,(void *)b,amount);captured_len+=amount;return amount;}
