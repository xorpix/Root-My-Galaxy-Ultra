# Android shell assets must remain executable text after a Windows checkout.
*.sh text eol=lf
# Compatibility patches are hashed byte-for-byte by the backend pipeline;
# a CRLF checkout breaks every checksum on Windows.
*.patch text eol=lf
/gradlew text eol=lf

# Preserve the source patch exactly, including the Samsung source CRLF context.
/backends/susfs/audit-fixes.patch -text
