diff --git a/kernel/susfs_control.c b/kernel/susfs_control.c
new file mode 100644
index 0000000..21ab3bf
--- /dev/null
+++ b/kernel/susfs_control.c
@@ -0,0 +1,47 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/mutex.h>
+#include <linux/rcupdate.h>
+#include <linux/wait.h>
+#include "susfs_control.h"
+
+static DEFINE_MUTEX(control_lock);
+static DECLARE_WAIT_QUEUE_HEAD(control_waitq);
+static unsigned int control_active;
+static bool control_stopping;
+
+int susfs_control_get(void)
+{
+    int rc = 0;
+
+    mutex_lock(&control_lock);
+    if (control_stopping)
+        rc = -ENODEV;
+    else
+        control_active++;
+    mutex_unlock(&control_lock);
+    return rc;
+}
+
+void susfs_control_put(void)
+{
+    mutex_lock(&control_lock);
+    if (WARN_ON_ONCE(!control_active)) {
+        mutex_unlock(&control_lock);
+        return;
+    }
+    if (!--control_active)
+        wake_up_all(&control_waitq);
+    mutex_unlock(&control_lock);
+}
+
+void susfs_control_shutdown(void)
+{
+    mutex_lock(&control_lock);
+    control_stopping = true;
+    mutex_unlock(&control_lock);
+    wait_event(control_waitq, !READ_ONCE(control_active));
+    /* The final put may wake us before its caller has returned to the kernel. */
+    synchronize_rcu_tasks();
+}
diff --git a/kernel/susfs_control.h b/kernel/susfs_control.h
new file mode 100644
index 0000000..68b7620
--- /dev/null
+++ b/kernel/susfs_control.h
@@ -0,0 +1,13 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef SUSFS_CONTROL_H
+#define SUSFS_CONTROL_H
+
+/* Process-context configuration only. A successful get must be paired with a
+ * final put, followed by no further resource access or voluntary scheduling.
+ * Parameter parsing before init is allowed; layers still validate readiness.
+ * Shutdown closes admission permanently and drains accepted configurations. */
+int susfs_control_get(void);
+void susfs_control_put(void);
+void susfs_control_shutdown(void);
+
+#endif
