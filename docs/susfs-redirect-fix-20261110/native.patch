+    else if (!strncmp(c, "missing-", 8)) {
+        if (!strcmp(c, "missing-all")) missing = 127;
+        else { target = atoi(c + 8); assert(target >= 0 && target < 7); missing = 1U << target; }
+    } else if (!strcmp(c, "optional-missing")) optional_missing = true;
+    else if (!strcmp(c, "fail-all")) for (i = 0; i < 5; i++) failures[i] = -EIO;
+    else if (!strncmp(c, "fail-", 5)) {
+        target = atoi(c + 5); assert(target >= 0 && target < 5); failures[target] = -EIO - target;
+    } else assert(!strcmp(c, "success"));
+    assert(!susfs_or_entry_init()); /* Receipt does not change the existing API. */
+    int n = or_entry_stat_get(buf, NULL);
+    assert(n > 0 && n < 1000 && (size_t)n == strlen(buf));
+    if (!strncmp(c,"protected-table",15)) {assert(installs==1);assert(or_entry_init_rc==fallback_rc && or_entry_probe_rc==fallback_rc);assert(or_entry_ready==!fallback_rc && susfs_or_entry_armed()==!fallback_rc);assert(strstr(buf,fallback_rc?"entries=0/5":"entries=5/5"));puts("PASS protected table fallback");return 0;}
+    if (!or_entry_param) {
+        assert(!lookups && !installs && !or_entry_symbols_checked && !or_entry_ready);
+        assert(or_entry_init_rc == -ECANCELED);
+    } else if (missing) {
