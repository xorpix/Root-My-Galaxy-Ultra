+        } else if (target >= 0) {
+            assert(or_entry_init_rc == -EOPNOTSUPP && or_entry_ready && !susfs_or_entry_armed());
+            assert(strstr(buf, "entries=4/5"));
+        } else {
+            assert(!or_entry_init_rc && or_entry_ready && susfs_or_entry_armed());
+            assert(strstr(buf, "armed=1 entries=5/5"));
+        }
+    }
+    printf("PASS %s\n", c);
+    return 0;
+}
