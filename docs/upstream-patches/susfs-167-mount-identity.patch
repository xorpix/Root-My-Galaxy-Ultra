new file mode 100644
--- /dev/null
+++ b/tests/mount_identity/run.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-2.0-only
+"""Exercise the actual mount-identity functions with host kernel API models."""
+import argparse
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import resource
+import subprocess
+import tempfile
+
+CASES = ["empty", "bind-parent", "namespace-copy", "shared-source",
+         "different-device", "long-source", "generic-source", "null-root",
+         "drop-reuse", "concurrent-reuse"]
+
+
+def function(source, name):
+    match = re.search(r"^static [^\n]*\b" + re.escape(name) +
+                      r"\([^;{]*\)\n\{\n.*?^\}\n", source, re.M | re.S)
+    if not match:
+        raise ValueError("Missing production function: " + name)
+    return match.group()
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source-dir", type=Path, default=Path(__file__).resolve().parents[2])
+    parser.add_argument("--sanitizers", action="store_true")
+    parser.add_argument("--json", type=Path)
+    args = parser.parse_args()
+    resource.setrlimit(resource.RLIMIT_CORE, (0, 0))
+    here = Path(__file__).resolve().parent
+    source = (args.source_dir / "kernel/sus_mount.c").read_text()
+    start = source.index("#define SUS_MOUNT_DEVNAME_MAX")
+    end = source.index("/* generic_shutdown_super(", start)
+    production = source[start:end] + function(source, "sus_mount_is_ours")
+    production += function(source, "sus_mount_shown_id_from")
+    flags = (["-O1", "-g", "-fsanitize=address,undefined", "-fno-omit-frame-pointer", "-no-pie"]
+             if args.sanitizers else ["-O2"])
+    env = dict(os.environ, ASAN_OPTIONS="detect_leaks=0:abort_on_error=1",
+               UBSAN_OPTIONS="halt_on_error=1")
+    results = []
+    with tempfile.TemporaryDirectory(prefix="susfs-mount-identity-") as temporary:
+        directory = Path(temporary)
+        header = directory / "production.h"
+        header.write_text(production)
+        binary = directory / "mount-identity"
+        subprocess.run([os.environ.get("CC", "cc"), "-std=gnu11", "-Wall", "-Wextra",
+                        "-Werror", "-Wno-unused-function", "-Wno-unused-variable", "-pthread",
+                        *flags, '-DPRODUCTION="' + str(header) + '"',
+                        str(here / "mount_identity_test.c"), "-o", str(binary)], check=True)
+        for case in CASES:
+            result = subprocess.run([str(binary), case], capture_output=True,
+                                    text=True, env=env, timeout=12)
+            results.append({"case": case, "exit_code": result.returncode,
+                            "stdout": result.stdout.strip(), "stderr": result.stderr.strip()})
+            print(("PASS " if result.returncode == 0 else "FAIL ") + case)
+    report = {"kind": "production mount identity C with explicit host kernel models",
+              "source_sha256": hashlib.sha256(source.encode()).hexdigest(),
+              "sanitizers": args.sanitizers, "hardware_validated": False, "results": results}
+    if args.json:
+        args.json.parent.mkdir(parents=True, exist_ok=True)
+        args.json.write_text(json.dumps(report, indent=2) + "\n")
+    return int(any(result["exit_code"] for result in results))
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
