new file mode 100644
--- /dev/null
+++ b/tests/mount_identity/README.md
@@ -0,0 +1,15 @@
+# Mount identity regressions
+
+Run `python3 tests/mount_identity/run.py` and repeat with `--sanitizers`.
+The harness compiles the production identity records and matching functions,
+plus the actual mount-selection and ancestor-selection functions.
+
+The fixtures cover #167's shared block-device source, namespace copies,
+different devices/inodes, truncated source strings, missing roots, retired
+records and a controlled retirement/reuse interleaving. A device/inode pair
+that was never published must never match. Configured source-prefix selection
+is outside this change and modeled as non-matching for these identity fixtures.
+
+These are host regression checks, not module execution or device validation.
+LeakSanitizer is disabled because the harness may run in restricted containers;
+ASan and UBSan remain enabled with `--sanitizers`.
diff --git a/tests/mount_identity/mount_identity_test.c b/tests/mount_identity/mount_identity_test.c
new file mode 100644
--- /dev/null
+++ b/tests/mount_identity/mount_identity_test.c
@@ -0,0 +1,210 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <assert.h>
+#include <errno.h>
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+
+typedef struct { int value; } atomic_t;
+#define ATOMIC_INIT(n) { n }
+#define atomic_inc(p) ((void)__atomic_add_fetch(&(p)->value, 1, __ATOMIC_RELAXED))
+#define atomic_inc_return(p) __atomic_add_fetch(&(p)->value, 1, __ATOMIC_RELAXED)
+#define DEFINE_SPINLOCK(n) pthread_mutex_t n = PTHREAD_MUTEX_INITIALIZER
+static void host_lock(pthread_mutex_t *lock);
+static void host_after_load(const void *address);
+#define spin_lock_irqsave(p, f) do { (f) = 0; host_lock(p); } while (0)
+#define spin_unlock_irqrestore(p, f) do { (void)(f); assert(!pthread_mutex_unlock(p)); } while (0)
+#define smp_store_release(p, n) __atomic_store_n((p), (n), __ATOMIC_RELEASE)
+#define smp_load_acquire(p) ({ __auto_type value = __atomic_load_n((p), __ATOMIC_ACQUIRE); host_after_load(p); value; })
+#define module_param_named(...)
+#define pr_warn(...) ((void)0)
+#define SUSFS_LOGI(...) ((void)0)
+#define DEFAULT_KSU_MNT_ID 2000000000U
+#define SUS_MOUNT_KSU_ID_MIN ((unsigned int)DEFAULT_KSU_MNT_ID)
+
+struct inode { unsigned long i_ino; };
+struct dentry { struct inode *d_inode; };
+struct super_block { uint64_t s_dev; };
+struct vfsmount { struct super_block *mnt_sb; struct dentry *mnt_root; };
+struct mount {
+    struct vfsmount mnt;
+    const char *mnt_devname;
+    int mnt_id;
+    struct mount *mnt_parent;
+};
+static int strscpy(char *dst, const char *src, size_t capacity)
+{
+    size_t n = strlen(src);
+    if (n >= capacity) n = capacity - 1;
+    memcpy(dst, src, n); dst[n] = 0;
+    return (int)n;
+}
+/* These fixtures register identities, not path prefixes. */
+static bool sus_mount_path_is_ours(const char *path) { (void)path; return false; }
+#include PRODUCTION
+
+static pthread_mutex_t model = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t changed = PTHREAD_COND_INITIALIZER;
+static _Thread_local int role;
+static bool reader_paused, writer_waiting, writer_done, resume_reader, query_result;
+static const void *pause_address;
+
+static void host_lock(pthread_mutex_t *lock)
+{
+    if (role == 2) {
+        assert(!pthread_mutex_lock(&model));
+        writer_waiting = true;
+        assert(!pthread_cond_broadcast(&changed));
+        assert(!pthread_mutex_unlock(&model));
+    }
+    assert(!pthread_mutex_lock(lock));
+}
+static void host_after_load(const void *address)
+{
+    if (role != 1 || address != pause_address || reader_paused) return;
+    assert(!pthread_mutex_lock(&model));
+    reader_paused = true;
+    assert(!pthread_cond_broadcast(&changed));
+    while (!resume_reader) assert(!pthread_cond_wait(&changed, &model));
+    assert(!pthread_mutex_unlock(&model));
+}
+static struct timespec deadline(int seconds)
+{
+    struct timespec t;
+    assert(!clock_gettime(CLOCK_REALTIME, &t));
+    t.tv_sec += seconds;
+    return t;
+}
+static void wait_flag(const bool *flag)
+{
+    struct timespec t = deadline(3);
+    while (!*flag) assert(!pthread_cond_timedwait(&changed, &model, &t));
+}
+static struct mount make_mount(struct super_block *sb, struct dentry *root,
+                               const char *name, int id, struct mount *parent)
+{
+    return (struct mount){ .mnt = { sb, root }, .mnt_devname = name,
+                           .mnt_id = id, .mnt_parent = parent };
+}
+static void identity_case(const char *name)
+{
+    struct inode data_inode = { 3 }, bind_inode = { 314159 }, other_inode = { 314160 };
+    struct dentry data_root = { &data_inode }, bind_root = { &bind_inode }, other_root = { &other_inode };
+    struct super_block data_sb = { 112 }, other_sb = { 113 };
+    struct mount data = make_mount(&data_sb, &data_root, "/dev/block/dm-112", 8127, NULL);
+    data.mnt_parent = &data;
+    struct mount bind = make_mount(&data_sb, &bind_root, "/dev/block/dm-112", 2000000001, &data);
+    struct mount copy = make_mount(&data_sb, &bind_root, "/dev/block/dm-112", 9000, &data);
+    struct mount other = make_mount(&data_sb, &other_root, "/dev/block/dm-112", 9001, &data);
+    if (!strcmp(name, "empty")) { assert(!sus_mount_ident_match(&data)); return; }
+    sus_mount_ident_add(&bind);
+    assert(sus_mount_ident_match(&bind));
+    if (!strcmp(name, "bind-parent")) {
+        assert(!sus_mount_is_ours(&data));
+        assert(sus_mount_is_ours(&copy));
+        assert(sus_mount_shown_id_from(&copy) == data.mnt_id);
+        assert(!sus_mount_is_ours(&data));
+    } else if (!strcmp(name, "namespace-copy")) {
+        copy.mnt_devname = NULL;
+        assert(sus_mount_ident_match(&copy));
+        sus_mount_ident_add(&copy);
+        assert(n_ident == 1);
+    } else if (!strcmp(name, "shared-source")) {
+        assert(!sus_mount_ident_match(&other));
+    } else if (!strcmp(name, "different-device")) {
+        copy.mnt.mnt_sb = &other_sb;
+        assert(!sus_mount_ident_match(&copy));
+    } else if (!strcmp(name, "long-source")) {
+        char a[150], b[150];
+        memset(a, 'a', sizeof(a)); a[0] = '/'; a[149] = 0;
+        memcpy(b, a, sizeof(a)); b[100] = 'b';
+        n_ident = 0; bind.mnt_devname = a;
+        sus_mount_ident_add(&bind);
+        other.mnt_devname = b;
+        assert(!sus_mount_ident_match(&other));
+        copy.mnt_devname = a;
+        assert(sus_mount_ident_match(&copy));
+    } else if (!strcmp(name, "generic-source")) {
+        n_ident = 0; bind.mnt_devname = "tmpfs";
+        sus_mount_ident_add(&bind);
+        other.mnt_devname = "tmpfs";
+        assert(!sus_mount_ident_match(&other));
+        assert(sus_mount_ident_match(&copy));
+    } else if (!strcmp(name, "null-root")) {
+        other.mnt.mnt_root = NULL;
+        assert(!sus_mount_ident_match(&other));
+        sus_mount_ident_add(&other);
+        assert(n_ident == 1);
+        other.mnt.mnt_root = &other_root; other_root.d_inode = NULL;
+        assert(!sus_mount_ident_match(&other));
+    } else if (!strcmp(name, "drop-reuse")) {
+        sus_mount_ident_drop_dev(data_sb.s_dev);
+        assert(!sus_mount_ident_match(&copy));
+        sus_mount_ident_add(&other);
+        assert(n_ident == 1 && sus_mount_ident_match(&other));
+        assert(!sus_mount_ident_match(&copy));
+    } else { abort(); }
+}
+
+static struct super_block old_sb = { 1 }, new_sb = { 2 };
+static struct inode old_inode = { 11 }, new_inode = { 99 };
+static struct dentry old_root = { &old_inode }, new_root = { &new_inode };
+static struct mount old_mount = { .mnt = { &old_sb, &old_root } },
+    new_mount = { .mnt = { &new_sb, &new_root } },
+    query = { .mnt = { &new_sb, &old_root } };
+static void *read_key(void *unused)
+{
+    (void)unused; role = 1;
+    query_result = sus_mount_ident_match(&query);
+    return NULL;
+}
+static void *replace_key(void *unused)
+{
+    (void)unused; role = 2;
+    sus_mount_ident_drop_dev(old_sb.s_dev);
+    sus_mount_ident_add(&new_mount);
+    assert(!pthread_mutex_lock(&model));
+    writer_done = true;
+    assert(!pthread_cond_broadcast(&changed));
+    assert(!pthread_mutex_unlock(&model));
+    return NULL;
+}
+static void concurrent_reuse(void)
+{
+    sus_mount_ident_add(&old_mount);
+    assert(!sus_mount_ident_match(&query));
+    pause_address = &mount_ident[0].root_ino;
+    pthread_t reader, writer;
+    assert(!pthread_create(&reader, NULL, read_key, NULL));
+    assert(!pthread_mutex_lock(&model)); wait_flag(&reader_paused);
+    assert(!pthread_mutex_unlock(&model));
+    assert(!pthread_create(&writer, NULL, replace_key, NULL));
+    assert(!pthread_mutex_lock(&model)); wait_flag(&writer_waiting);
+    /* Force the old lock-free reader's inode snapshot across slot reuse. A
+     * serialized reader instead makes the writer wait until that snapshot ends. */
+    struct timespec t = deadline(1);
+    while (!writer_done) {
+        int rc = pthread_cond_timedwait(&changed, &model, &t);
+        if (rc == ETIMEDOUT) break;
+        assert(!rc);
+    }
+    resume_reader = true;
+    assert(!pthread_cond_broadcast(&changed)); assert(!pthread_mutex_unlock(&model));
+    assert(!pthread_join(reader, NULL)); assert(!pthread_join(writer, NULL));
+    /* (device 2, inode 11) was never a published key. */
+    assert(!query_result);
+    assert(!sus_mount_ident_match(&query));
+    assert(sus_mount_ident_match(&new_mount));
+}
+int main(int argc, char **argv)
+{
+    assert(argc == 2);
+    if (!strcmp(argv[1], "concurrent-reuse")) concurrent_reuse();
+    else identity_case(argv[1]);
+    printf("PASS %s\n", argv[1]);
+    return 0;
+}
