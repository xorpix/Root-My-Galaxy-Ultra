+	args->start = m->count;
+	return 0;
+}
+
+static int cmdline_show_ret(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+	struct cmdline_show_args *args = (struct cmdline_show_args *)ri->data;
+	struct seq_file *m = args->m;
+	const char *fake;
+	size_t start = args->start, len;
+
+	if (regs_return_value(regs) || !m)
+		return 0;
+	fake = smp_load_acquire(&fake_boot_config);
+	if (!fake)
+		return 0;
+	if (start > m->count || m->count > m->size ||
+	    (!m->buf && m->count != m->size)) {
+		/* A malformed show result must not deliver the original command line. */
+		m->count = 0;
+		regs->regs[0] = (unsigned long)-EIO;
+		return 0;
+	}
+	/* Erase the original appended bytes, including a shorter fake's tail.
+	 * count == size is seq_file's overflow flag: preserve its retry protocol. */
+	if (m->buf && m->count > start)
+		memset(m->buf + start, 0, m->count - start);
+	if (m->count == m->size)
+		return 0;
+	len = strlen(fake);
