+ * internal command line untouched; replace only cmdline_proc_show()'s output.
+ * The existing Tasks-RCU retirement also covers this non-sleeping reader. */
+struct cmdline_show_args {
+	struct seq_file *m;
+	size_t start;
+};
+
+static int cmdline_show_entry(struct kretprobe_instance *ri, struct pt_regs *regs)
+{
+	struct cmdline_show_args *args = (struct cmdline_show_args *)ri->data;
+	struct seq_file *m = (struct seq_file *)regs->regs[0];
+
+	if (!m || !smp_load_acquire(&fake_boot_config))
+		return 1;
