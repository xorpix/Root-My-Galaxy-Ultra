diff --git a/kernel/susfs_or_entry.c b/kernel/susfs_or_entry.c
index 2cec045fea8579608bde9ccea8117e9182a1c505..e3ea6e582e0b620fcf2d7594a8ebb73e19207d2c 100644
--- a/kernel/susfs_or_entry.c
+++ b/kernel/susfs_or_entry.c
@@ -561,6 +561,17 @@ unsigned long susfs_or_entry_hits(void)
 	return (unsigned long)atomic_read(&or_entry_hits);
 }
 
+/* Test-only startup receipt. Written only by init, never by an open wrapper.
+ * Keep the actual failure available when the kernel log cannot be collected. */
+static int or_entry_init_rc = -EINPROGRESS;
+static bool or_entry_symbols_checked;
+static unsigned int or_entry_missing_symbols;
+static int or_entry_hook_rc[5] = { [0 ... 4] = -ECANCELED };
+static const char *const or_entry_symbol_names[] = {
+	"getname_flags", "filename_lookup", "putname", "filp_open",
+	"get_unused_fd_flags", "fd_install", "put_unused_fd",
+};
+
 /* One line of counters for /sys/module/susfs_guard_lkm/parameters/or_entry_stat (fork style, like
  * redirect_map_stat): armed state, how many of the five entries actually carry a wrapper, and how
  * many redirects the wrappers handed out.  Not the /proc hooks line - that one's format belongs to
@@ -569,13 +580,32 @@ static int or_entry_stat_get(char *buf, const struct kernel_param *kp)
 {
 	int installed = 0;
 	int i;
+	int n;
+	unsigned int missing = READ_ONCE(or_entry_missing_symbols);
 
 	for (i = 0; i < (int)ARRAY_SIZE(or_hooks); i++)
 		if (READ_ONCE(or_hooks[i].installed))
 			installed++;
-	return scnprintf(buf, PAGE_SIZE, "armed=%d entries=%d/%u hits=%lu\n",
+	n = scnprintf(buf, PAGE_SIZE, "armed=%d entries=%d/%u hits=%lu\n",
 			 susfs_or_entry_armed(), installed,
 			 (unsigned int)ARRAY_SIZE(or_hooks), susfs_or_entry_hits());
+	n += scnprintf(buf + n, PAGE_SIZE - n,
+		"init_rc=%d symbols_checked=%u missing=",
+		READ_ONCE(or_entry_init_rc), READ_ONCE(or_entry_symbols_checked) ? 1 : 0);
+	if (!missing)
+		n += scnprintf(buf + n, PAGE_SIZE - n, "none");
+	for (i = 0; i < (int)ARRAY_SIZE(or_entry_symbol_names); i++) {
+		if (!(missing & (1U << i)))
+			continue;
+		n += scnprintf(buf + n, PAGE_SIZE - n, "%s%s",
+			(missing & ((1U << i) - 1)) ? "," : "", or_entry_symbol_names[i]);
+	}
+	n += scnprintf(buf + n, PAGE_SIZE - n, "\nhook_rc:");
+	for (i = 0; i < (int)ARRAY_SIZE(or_hooks); i++)
+		n += scnprintf(buf + n, PAGE_SIZE - n, " %s=%d",
+			or_hooks[i].name, READ_ONCE(or_entry_hook_rc[i]));
+	n += scnprintf(buf + n, PAGE_SIZE - n, "\n");
+	return n;
 }
 static const struct kernel_param_ops or_entry_stat_ops = { .get = or_entry_stat_get };
 module_param_cb(or_entry_stat, &or_entry_stat_ops, NULL, 0444);
@@ -591,6 +621,7 @@ int susfs_or_entry_init(void)
 	 * keep the entries occupied without ever redirecting, so the parameter is honoured
 	 * here and the entries simply stay untouched. */
 	if (!READ_ONCE(or_entry_param)) {
+		WRITE_ONCE(or_entry_init_rc, -ECANCELED);
 		SUSFS_LOGI("or_entry=0: name layer off (open_redirect will refuse rules)\n");
 		return 0;
 	}
@@ -619,9 +650,19 @@ int susfs_or_entry_init(void)
 	if (!or_check_zeroed_user_fn)
 		SUSFS_LOGI("or_entry: check_zeroed_user not found - openat2 with a larger open_how is not redirected\n");
 
+	WRITE_ONCE(or_entry_missing_symbols,
+		(!or_getname_flags_fn ? 1U << 0 : 0) |
+		(!or_filename_lookup_fn ? 1U << 1 : 0) |
+		(!or_putname_fn ? 1U << 2 : 0) |
+		(!or_filp_open_fn ? 1U << 3 : 0) |
+		(!or_get_unused_fd_flags_fn ? 1U << 4 : 0) |
+		(!or_fd_install_fn ? 1U << 5 : 0) |
+		(!or_put_unused_fd_fn ? 1U << 6 : 0));
+	WRITE_ONCE(or_entry_symbols_checked, true);
 	if (!or_getname_flags_fn || !or_filename_lookup_fn || !or_putname_fn ||
 	    !or_filp_open_fn || !or_get_unused_fd_flags_fn || !or_fd_install_fn ||
 	    !or_put_unused_fd_fn) {
+		WRITE_ONCE(or_entry_init_rc, -ENOENT);
 		SUSFS_LOGI("or_entry: not armed, a symbol is missing (getname_flags=%d filename_lookup=%d putname=%d filp_open=%d get_unused_fd_flags=%d fd_install=%d put_unused_fd=%d) - open_redirect will refuse rules\n",
 			   !!or_getname_flags_fn, !!or_filename_lookup_fn, !!or_putname_fn,
 			   !!or_filp_open_fn, !!or_get_unused_fd_flags_fn, !!or_fd_install_fn,
@@ -637,6 +678,7 @@ int susfs_or_entry_init(void)
 		struct susfs_fp_hook *h = &or_hooks[i];
 
 		rc = susfs_fp_install(h);
+		WRITE_ONCE(or_entry_hook_rc[i], rc);
 		if (rc) {
 			pr_warn("or_entry: %s not installed (%d) - that syscall answers the kernel's own way\n",
 				h->name, rc);
@@ -645,6 +687,7 @@ int susfs_or_entry_init(void)
 		installed++;
 	}
 	if (!installed) {
+		WRITE_ONCE(or_entry_init_rc, or_entry_hook_rc[0]);
 		pr_warn("or_entry: none of the %u open entries could be installed - the name layer stays off (open_redirect will refuse rules)\n",
 			(unsigned int)ARRAY_SIZE(or_hooks));
 		return 0;
@@ -657,6 +700,7 @@ int susfs_or_entry_init(void)
 	 * freshly published wrapper before this store sees PASS and runs the original syscall -
 	 * the safe direction - so the store needs no ordering against the table patch. */
 	WRITE_ONCE(or_entry_ready, true);
+	WRITE_ONCE(or_entry_init_rc, susfs_or_entry_armed() ? 0 : -EOPNOTSUPP);
 
 	SUSFS_LOGI("or_entry armed: %d of %u open entries; open_redirect rules hold no inode while it is on\n",
 		   installed, (unsigned int)ARRAY_SIZE(or_hooks));
diff --git a/tests/redirect_startup/run.py b/tests/redirect_startup/run.py
new file mode 100644
index 0000000000000000000000000000000000000000..c8290736ba3ebe830e363565a868a172fbddb43a
--- /dev/null
+++ b/tests/redirect_startup/run.py
@@ -0,0 +1,66 @@
+#!/usr/bin/env python3
+"""Inject startup failures into the real redirect init and status getter."""
+import argparse
+import importlib.util
+import os
+from pathlib import Path
+import re
+import subprocess
+import tempfile
+
+p = argparse.ArgumentParser(description=__doc__)
+p.add_argument('--sanitizers', action='store_true')
+a = p.parse_args()
+root = Path(__file__).resolve().parents[2]
+spec = importlib.util.spec_from_file_location('extract', root / 'tests/path_creds/run.py')
+extract = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(extract)
+source = (root / 'kernel/susfs_or_entry.c').read_text()
+receipt = source[source.index('static int or_entry_init_rc'):source.index('/* One line of counters for')]
+hook_table = source[source.index('static struct susfs_fp_hook or_hooks[]'):source.index('bool susfs_or_entry_armed')]
+names = re.findall(r'\.name = "([^"]+)"', hook_table)
+assert len(names) == 5
+hooks = 'static struct susfs_fp_hook or_hooks[] = {' + ','.join('{.name="' + n + '"}' for n in names) + '};\n'
+slots = re.findall(r'^static [^;\n]*\(\*(or_\w+_fn)\)', source, re.M)
+assert len(slots) == 9
+declarations = '\n'.join('static void *' + n + ';' for n in slots)
+production = receipt + '\n' + declarations + '\n' + hooks + '\n'
+production += '\n\n'.join(extract.function(source, n) for n in (
+    'susfs_or_entry_armed', 'susfs_or_entry_hits', 'or_entry_stat_get', 'susfs_or_entry_init'))
+cases = ['pending', 'success', 'disabled', 'missing-all', 'optional-missing', 'fail-all']
+cases += ['missing-' + str(i) for i in range(7)]
+cases += ['fail-' + str(i) for i in range(5)]
+flags = ['-O1', '-g', '-fsanitize=address,undefined', '-fno-omit-frame-pointer', '-no-pie'] if a.sanitizers else ['-O2']
+env = dict(os.environ, ASAN_OPTIONS='detect_leaks=0:abort_on_error=1', UBSAN_OPTIONS='halt_on_error=1')
+here = Path(__file__).resolve().parent
+with tempfile.TemporaryDirectory(prefix='susfs-redirect-startup-') as work:
+    work = Path(work)
+    def build(text, label):
+        header = work / (label + '.h')
+        header.write_text(text)
+        exe = work / label
+        subprocess.run([os.environ.get('CC', 'cc'), '-std=gnu11', '-Wall', '-Wextra', '-Werror',
+                        '-Wno-unused-parameter', *flags, '-DPRODUCTION="' + str(header) + '"',
+                        str(here / 'startup_test.c'), '-o', str(exe)], check=True)
+        return exe
+    exe = build(production, 'startup')
+    for case in cases:
+        subprocess.run([str(exe), case], check=True, env=env, timeout=15)
+    mutations = [
+        ('missing-mask-lost', 'or_entry_missing_symbols,\n', 'or_entry_missing_symbols, 0 * (\n',
+         '(!or_put_unused_fd_fn ? 1U << 6 : 0));', '(!or_put_unused_fd_fn ? 1U << 6 : 0)));', 'missing-6'),
+        ('hook-error-lost', 'WRITE_ONCE(or_entry_hook_rc[i], rc);',
+         'WRITE_ONCE(or_entry_hook_rc[i], 0);', None, None, 'fail-3'),
+        ('init-error-lost', 'WRITE_ONCE(or_entry_init_rc, -ENOENT);',
+         'WRITE_ONCE(or_entry_init_rc, 0);', None, None, 'missing-0'),
+    ]
+    for label, old, new, old2, new2, case in mutations:
+        assert old in production
+        changed = production.replace(old, new, 1)
+        if old2:
+            assert old2 in changed
+            changed = changed.replace(old2, new2, 1)
+        mutated = build(changed, label)
+        result = subprocess.run([str(mutated), case], env=env, capture_output=True, timeout=15)
+        assert result.returncode != 0, 'mutation escaped: ' + label
+        print('PASS mutation rejected: ' + label)
diff --git a/tests/redirect_startup/startup_test.c b/tests/redirect_startup/startup_test.c
new file mode 100644
index 0000000000000000000000000000000000000000..eb51621c228700645f6bad8e889f4cfd253ea878
--- /dev/null
+++ b/tests/redirect_startup/startup_test.c
@@ -0,0 +1,103 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#include <assert.h>
+#include <errno.h>
+#include <stdbool.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define READ_ONCE(x) (x)
+#define WRITE_ONCE(x,v) ((x) = (v))
+#define ARRAY_SIZE(x) (sizeof(x) / sizeof((x)[0]))
+#define PAGE_SIZE 4096
+#define CONFIG_COMPAT 1
+#define SUSFS_LOGI(...) ((void)0)
+#define pr_warn(...) ((void)0)
+#define scnprintf snprintf
+struct kernel_param { int unused; };
+struct susfs_fp_hook { const char *name; bool installed, compat_installed; };
+static bool or_entry_ready, or_entry_param = true;
+static int or_entry_hits;
+#define atomic_read(p) (*(p))
+static unsigned int missing;
+static bool optional_missing;
+static int installs, lookups, failures[5];
+static const char *const required[] = {
+    "getname_flags", "filename_lookup", "putname", "filp_open",
+    "get_unused_fd_flags", "fd_install", "put_unused_fd",
+};
+static unsigned long find_kernel_symbol_exact(const char *name)
+{
+    unsigned int i;
+    lookups++;
+    for (i = 0; i < ARRAY_SIZE(required); i++)
+        if (!strcmp(name, required[i]))
+            return missing & (1U << i) ? 0 : 1;
+    assert(!strcmp(name, "fsnotify_open") || !strcmp(name, "check_zeroed_user"));
+    return optional_missing ? 0 : 1;
+}
+static int susfs_fp_install(struct susfs_fp_hook *hook)
+{
+    int rc = failures[installs++];
+    if (!rc)
+        hook->installed = hook->compat_installed = true;
+    return rc;
+}
+#include PRODUCTION
+int main(int argc, char **argv)
+{
+    char buf[PAGE_SIZE], expected[128];
+    int target = -1, i;
+    assert(argc == 2);
+    const char *c = argv[1];
+    if (!strcmp(c, "pending")) {
+        or_entry_stat_get(buf, NULL);
+        assert(strstr(buf, "init_rc=-115 symbols_checked=0"));
+        assert(strstr(buf, "or/openat=-125"));
+        puts("PASS pending");
+        return 0;
+    }
+    if (!strcmp(c, "disabled")) or_entry_param = false;
+    else if (!strncmp(c, "missing-", 8)) {
+        if (!strcmp(c, "missing-all")) missing = 127;
+        else { target = atoi(c + 8); assert(target >= 0 && target < 7); missing = 1U << target; }
+    } else if (!strcmp(c, "optional-missing")) optional_missing = true;
+    else if (!strcmp(c, "fail-all")) for (i = 0; i < 5; i++) failures[i] = -EIO;
+    else if (!strncmp(c, "fail-", 5)) {
+        target = atoi(c + 5); assert(target >= 0 && target < 5); failures[target] = -EACCES - target;
+    } else assert(!strcmp(c, "success"));
+    assert(!susfs_or_entry_init()); /* Receipt does not change the existing API. */
+    int n = or_entry_stat_get(buf, NULL);
+    assert(n > 0 && n < 1000 && (size_t)n == strlen(buf));
+    if (!or_entry_param) {
+        assert(!lookups && !installs && !or_entry_symbols_checked && !or_entry_ready);
+        assert(or_entry_init_rc == -ECANCELED);
+    } else if (missing) {
+        assert(lookups == 9 && !installs && or_entry_symbols_checked && !or_entry_ready);
+        assert(or_entry_init_rc == -ENOENT && or_entry_missing_symbols == missing);
+        if (target >= 0) {
+            snprintf(expected, sizeof(expected), "missing=%s\n", required[target]);
+            assert(strstr(buf, expected));
+        } else assert(strstr(buf, "missing=getname_flags,filename_lookup,putname,filp_open,get_unused_fd_flags,fd_install,put_unused_fd\n"));
+        for (i = 0; i < 5; i++) assert(or_entry_hook_rc[i] == -ECANCELED);
+    } else {
+        assert(lookups == 9 && installs == 5 && or_entry_symbols_checked);
+        assert(!or_entry_missing_symbols && strstr(buf, "missing=none\n"));
+        for (i = 0; i < 5; i++) {
+            assert(or_entry_hook_rc[i] == failures[i]);
+            snprintf(expected, sizeof(expected), "%s=%d", or_hooks[i].name, failures[i]);
+            assert(strstr(buf, expected));
+        }
+        if (!strcmp(c, "fail-all")) {
+            assert(or_entry_init_rc == -EIO && !or_entry_ready && !susfs_or_entry_armed());
+            assert(strstr(buf, "entries=0/5"));
+        } else if (target >= 0) {
+            assert(or_entry_init_rc == -EOPNOTSUPP && or_entry_ready && !susfs_or_entry_armed());
+            assert(strstr(buf, "entries=4/5"));
+        } else {
+            assert(!or_entry_init_rc && or_entry_ready && susfs_or_entry_armed());
+            assert(strstr(buf, "armed=1 entries=5/5"));
+        }
+    }
+    printf("PASS %s\n", c);
+    return 0;
+}
