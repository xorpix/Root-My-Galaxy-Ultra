+	spin_lock_irqsave(&hide_modules_lock, flags);
+	if (auto_modules_enabled && !hide_modules_stock_locked(name))
+		for (i = 0; i < n_auto_modules; i++)
+			if (!strcmp(name, auto_modules[i].name) &&
