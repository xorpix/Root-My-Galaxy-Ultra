+ * place; the configuration mutex serializes writes to the staging table. */
+static bool hide_modules_stock_locked(const char *name)
+{
+	int lo = 0, hi = n_auto_stock;
+
+	while (lo < hi) {
+		int mid = lo + (hi - lo) / 2;
+		int cmp = strcmp(name, auto_stock[mid]);
+
+		if (!cmp)
+			return true;
+		if (cmp < 0)
+			hi = mid;
+		else
+			lo = mid + 1;
+	}
+	return false;
