+/* Configuration lock held. Release only this feature's module-owned rules;
+ * independent user/path owners are preserved by the path layer. */
+static void hide_modules_auto_sync(void)
+{
+	char path[sizeof("/sys/module/") - 1 + MODULE_NAME_LEN];
+	unsigned long flags;
+	int i;
+
+	if (!sus_path_lsm_active())
+		return;
+	for (i = 0; ; i++) {
+		bool wanted, manual, dirty, applied;
+		int rc;
+
+		spin_lock_irqsave(&hide_modules_lock, flags);
+		if (i >= n_auto_modules) {
+			spin_unlock_irqrestore(&hide_modules_lock, flags);
+			break;
+		}
+		manual = hide_modules_manual_locked(auto_modules[i].name);
+		wanted = auto_modules_enabled &&
+			auto_modules[i].presence != HIDE_MODULE_GONE &&
+			!hide_modules_stock_locked(auto_modules[i].name);
+		dirty = auto_modules[i].dirty;
+		auto_modules[i].dirty = false;
+		applied = auto_modules[i].applied;
