+/* Module-path rules have a distinct owner. They never borrow or delete a
+ * user/control rule, even when the rules resolve to the same inode. */
+static bool sus_path_module_path_ok(const char *path)
+{
+	const char prefix[] = "/sys/module/";
+	size_t len;
+
+	if (!path)
+		return false;
+	len = strnlen(path, SUS_PATH_LEN);
+	if (len <= sizeof(prefix) - 1 || len >= SUS_PATH_LEN ||
+	    strncmp(path, prefix, sizeof(prefix) - 1))
+		return false;
+	return susfs_module_name_valid(path + sizeof(prefix) - 1, len - (sizeof(prefix) - 1));
+}
+
+/* Internal lifecycle API: hide_syms stops its notifier/work before sus_path
+ * exits. Cleanup must also work after the public control gate has closed. */
+int sus_path_release_module_hidden(const char *path)
+{
+	struct sus_path_entry *e, *tmp;
+	LIST_HEAD(doomed);
+	int removed = 0;
+
+	if (!sus_path_module_path_ok(path))
+		return -EINVAL;
+	spin_lock(&sus_path_lock);
+	list_for_each_entry_safe(e, tmp, &sus_path_list, list) {
+		if (!e->module_protect || strcmp(e->path, path))
+			continue;
+		if (!e->inode)
+			atomic_dec(&sus_path_n_pending);
+		sus_path_prepare_release(e);
+		sus_path_index_del(e);
+		list_del(&e->list);
+		list_add_tail(&e->list, &doomed);
+		sus_path_count--;
+		removed++;
+	}
+	spin_unlock(&sus_path_lock);
+	list_for_each_entry_safe(e, tmp, &doomed, list) {
+		list_del(&e->list);
+		sus_path_entry_free(e);
+	}
+	return removed;
+}
+
+/* Process context only. Return 0 for the same inode, 1 for a new/rebound
+ * module-owned rule, or a negative errno. Replacements publish under one lock;
+ * the old rule remains effective through allocation/lookup failures. */
+int sus_path_sync_module_hidden(const char *path)
+{
+	struct sus_path_entry *e, *cur, *tmp;
+	struct path p;
+	struct inode *inode;
+	LIST_HEAD(doomed);
+	bool replacing = false;
+	int rc;
+
+	if (!sus_path_module_path_ok(path))
+		return -EINVAL;
+	if (!READ_ONCE(sus_path_ready))
+		return -ENODEV;
+	rc = kern_path(path, LOOKUP_FOLLOW, &p);
+	if (rc) {
+		if (rc == -ENOENT || rc == -ENOTDIR)
+			sus_path_release_module_hidden(path);
+		return rc;
+	}
+	inode = d_inode(p.dentry);
+	if (!inode) {
+		path_put(&p);
+		sus_path_release_module_hidden(path);
+		return -ENOENT;
+	}
+	spin_lock(&sus_path_lock);
+	list_for_each_entry(cur, &sus_path_list, list) {
+		if (cur->module_protect && !strcmp(cur->path, path) && cur->inode == inode) {
+			spin_unlock(&sus_path_lock);
+			path_put(&p);
+			return 0;
+		}
+	}
+	spin_unlock(&sus_path_lock);
+	e = kzalloc(sizeof(*e), GFP_KERNEL);
+	if (!e) {
+		path_put(&p);
+		return -ENOMEM;
+	}
+	e->inode = inode;
+	ihold(inode);
+	e->dev = (u64)inode->i_sb->s_dev;
+	e->ino = (u64)inode->i_ino;
+	e->self_protect = true;
+	e->module_protect = true;
+	strscpy(e->name, p.dentry->d_name.name, sizeof(e->name));
+	sus_path_entry_set_path(e, path);
+	INIT_LIST_HEAD(&e->list);
+	spin_lock(&sus_path_lock);
+	list_for_each_entry(cur, &sus_path_list, list) {
+		if (!cur->module_protect || strcmp(cur->path, path))
+			continue;
+		if (cur->inode == inode) {
+			spin_unlock(&sus_path_lock);
+			path_put(&p);
+			sus_path_entry_free(e);
+			return 0;
+		}
+		replacing = true;
+	}
+	if (!replacing && sus_path_count >= SUS_PATH_MAX_ENTRIES) {
+		spin_unlock(&sus_path_lock);
+		path_put(&p);
+		sus_path_entry_free(e);
+		return -ENOSPC;
+	}
+	list_for_each_entry_safe(cur, tmp, &sus_path_list, list) {
+		if (!cur->module_protect || strcmp(cur->path, path))
+			continue;
+		if (!cur->inode)
+			atomic_dec(&sus_path_n_pending);
+		sus_path_prepare_release(cur);
+		sus_path_index_del(cur);
+		list_del(&cur->list);
+		list_add_tail(&cur->list, &doomed);
+		sus_path_count--;
+	}
+	sus_path_index_add(e);
+	list_add_tail(&e->list, &sus_path_list);
+	sus_path_count++;
+	spin_unlock(&sus_path_lock);
+	path_put(&p);
+	list_for_each_entry_safe(cur, tmp, &doomed, list) {
+		list_del(&cur->list);
+		sus_path_entry_free(cur);
+	}
+	sus_path_hooks_arm();
+	return 1;
+}
