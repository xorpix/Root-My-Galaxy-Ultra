index 3ba8cbb88117ecc93d5a972635205d24a104e556..35e6f521005a7ecc3735d0bea5b61925abac95f5 100644
--- a/tools/check_priority_artifact.py
+++ b/tools/check_priority_artifact.py
@@ -7,6 +7,7 @@ from review_cp15_artifact import inspect
 p=argparse.ArgumentParser(description=__doc__)
 p.add_argument("--baseline-is-priority",action="store_true",help="Compare with the previous priority build rather than pre-priority stable")
 p.add_argument("--baseline-is-audit",action="store_true",help="Compare audit repairs with the audited 8b9d19b production module")
+p.add_argument("--baseline-is-module-policy",action="store_true",help="Check the two module-notifier imports and real-header callback types against the NoMount build")
 for n in ('candidate','baseline','kdir','clang-bin','output'):p.add_argument('--'+n,type=Path,required=True)
 a=p.parse_args();root=Path(__file__).resolve().parents[1];a.output.mkdir(parents=True,exist_ok=True)
 fixture=a.output/'fixture';fixture.mkdir(exist_ok=True)
@@ -26,6 +27,15 @@ lines=['#include <linux/kprobes.h>','#include <linux/module.h>','#include <linux
 for file in ['susfs_create_gate.c','susfs_priority_filter.c']:
  for name,num in re.findall(r'^#define COMPAT_(\w+)_NR\s+(\d+)',(root/'kernel'/file).read_text(),re.M):lines.append(f'static_assert({num} == __NR_compat32_{name.lower()});')
 lines.append('MODULE_LICENSE("GPL");');(fixture/'fixture.c').write_text('\n'.join(lines)+'\n');(fixture/'Makefile').write_text('obj-m := fixture.o\n')
+if a.baseline_is_module_policy:
+ lines.extend(['#include <linux/notifier.h>','#include <linux/workqueue.h>',
+  'static __used int expected_module_notifier(struct notifier_block *nb, unsigned long event, void *data) { return NOTIFY_DONE; }',
+  'static __used void expected_module_work(struct work_struct *work) {}',
+  'static struct notifier_block expected_module_notifier_pointer __used = { .notifier_call=expected_module_notifier };',
+  'static work_func_t expected_module_work_pointer __used = expected_module_work;',
+  'static_assert(__same_type(typeof(&expected_module_notifier), typeof(((struct notifier_block *)0)->notifier_call)));',
+  'static_assert(__same_type(typeof(&expected_module_work), work_func_t));'])
+ (fixture/'fixture.c').write_text('\n'.join(lines)+'\n')
 env=dict(os.environ);env['PATH']=str(a.clang_bin)+os.pathsep+env['PATH']
 with (a.output/'fixture-build.log').open('w') as log:subprocess.run(['make','-C',str(a.kdir.resolve()),'M='+str(fixture.resolve()),'ARCH=arm64','CC=clang','LLVM=1','LLVM_IAS=1','CONFIG_DEBUG_INFO_BTF_MODULES=','modules','-j2'],stdout=log,stderr=subprocess.STDOUT,env=env,check=True)
 before=inspect(a.baseline);candidate=inspect(a.candidate);expected=inspect(fixture/'fixture.ko');word=expected['types']['expected_syscall']
@@ -45,11 +55,15 @@ checks={
  'all_have_call_landing_instructions':len(landings)==22 and all(v in [0xd503245f,0xd50324df,0xd503233f,0xd503237f] for v in landings.values()),
  'priority_probe_callbacks_match_real_headers':all(probe_words[n]==expected['types']['expected_post' if n=='prio_probe_post' else 'expected_pre'] for n in probe_names),
  'baseline_imports_preserved':set(removed)==({'mas_find'} if a.baseline_is_audit else set()),
- 'imports_match_expected_baseline':set(added)==({'deactivate_super'} if a.baseline_is_audit else (set() if a.baseline_is_priority else {'_ctype','strim','strsep','preempt_schedule'})),
+ 'imports_match_expected_baseline':set(added)==({'register_module_notifier','unregister_module_notifier'} if a.baseline_is_module_policy else ({'deactivate_super'} if a.baseline_is_audit else (set() if a.baseline_is_priority else {'_ctype','strim','strsep','preempt_schedule'}))),
  'module_metadata_matches_production_parameters':sorted(candidate['modinfo'])==sorted([v for v in before['modinfo'] if v != 'parmtype=fail_layer:int']+([] if a.baseline_is_priority or a.baseline_is_audit else ['parmtype=priority_auto_root:bool','parmtype=priority_appid:int'])),
  'version_table_shape_unchanged':candidate['version_section_sizes']==before['version_section_sizes'],
  'baseline_callback_types_preserved':all(candidate['types'].get(n)==v for n,v in before['types'].items() if n in candidate['types']),
 }
+if a.baseline_is_module_policy:
+ checks['module_callbacks_match_real_headers']=all(candidate['types'].get(name)==expected['types'][typed] for name,typed in [('hide_modules_notify','expected_module_notifier'),('hide_modules_work','expected_module_work')])
+ exports={line.split()[1] for line in (a.kdir/'Module.symvers').read_text().splitlines() if len(line.split())>=2}
+ checks['module_notifiers_exported_by_pinned_ddk']=set(added)<=exports
 report=dict(hardware_validated=False,checks=checks,wrapper_kcfi=words,probe_callback_kcfi=probe_words,baseline_is_priority=a.baseline_is_priority,wrapper_landing_instructions=landings,imports=candidate['imports'],added_imports=added,removed_imports=removed,version_section_sizes=candidate['version_section_sizes'],candidate_sha256=candidate['sha256'],baseline_sha256=before['sha256'])
 (a.output/'artifact.json').write_text(json.dumps(report,indent=2)+'\n')
 for n,v in checks.items():print(('PASS ' if v else 'FAIL ')+n)
