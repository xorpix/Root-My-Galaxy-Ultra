index ac33a4d74bea6baeec96a34922f1eba42df6252c..8c0e0fba36e7a66e12a1cc3f08c814a708abdfa9 100644
--- a/tests/path_creds/path_creds_test.c
+++ b/tests/path_creds/path_creds_test.c
@@ -93,7 +93,9 @@ static void verify_index(void) {
     struct sus_path_entry *e;
     for(unsigned b=0;b<SUS_PATH_INDEX_SIZE;b++) {
         for(e=sus_path_index[b];e;e=e->index_next) {
-            assert(e->inode&&sus_path_index_bucket(e->ino)==b&&find(e->path)==e);
+            struct sus_path_entry *p; bool published=false;
+            list_for_each_entry(p,&sus_path_list,list)if(p==e)published=true;
+            assert(e->inode&&sus_path_index_bucket(e->ino)==b&&published);
             assert(++indexed<=sus_path_count);
         }
     }
@@ -111,6 +113,71 @@ static void clean(void) {
 int main(int argc,char **argv)
 {
     assert(argc==2);alarm(12);setup();const char *name=argv[1];
+    if(!strncmp(name,"module-",7)) {
+        current->cred=&worker;
+        files[0].path="/sys/module/sample";files[0].tag=worker.tag;files[0].exists=true;
+        files[0].dentry.d_name.name="sample";
+        const char *path=files[0].path;
+        if(!strcmp(name,"module-invalid")) {
+            const char *bad[]={NULL,"/owned/a","/sys/module/","/sys/module/..","/sys/module/a/b","/sys/module/a:bad"};
+            for(unsigned i=0;i<sizeof(bad)/sizeof(bad[0]);i++) {
+                assert(sus_path_sync_module_hidden(bad[i])==-EINVAL);
+                assert(sus_path_release_module_hidden(bad[i])==-EINVAL);
+            }
+        } else {
+            if(!strcmp(name,"module-user-first"))assert(!add(path,CMD_SUSFS_ADD_SUS_PATH));
+            assert(sus_path_sync_module_hidden(path)==1);
+            struct sus_path_entry *owned=NULL,*p;
+            list_for_each_entry(p,&sus_path_list,list)if(p->module_protect)owned=p;
+            assert(owned && owned->self_protect && owned->inode==&files[0].inode);
+            if(!strcmp(name,"module-idempotent")) {
+                int calls=allocation_calls;
+                assert(!sus_path_sync_module_hidden(path));
+                assert(allocation_calls==calls && sus_path_count==1 && find(path)==owned);
+            } else if(!strcmp(name,"module-user-first")) {
+                assert(sus_path_count==2 && sus_path_release_module_hidden(path)==1);
+                assert(sus_path_count==1 && !find(path)->module_protect);
+            } else if(!strcmp(name,"module-owner-first")) {
+                assert(!add(path,CMD_SUSFS_ADD_SUS_PATH) && sus_path_count==2);
+                assert(sus_path_del_path(path)==1 && sus_path_count==1 && find(path)==owned);
+            } else if(!strcmp(name,"module-control-overlap")) {
+                p=kzalloc(sizeof(*p),GFP_KERNEL);assert(p);p->self_protect=true;
+                p->inode=&files[0].inode;p->dev=sb.s_dev;p->ino=p->inode->i_ino;ihold(p->inode);
+                sus_path_entry_set_path(p,path);strscpy(p->name,"sample",sizeof(p->name));
+                INIT_LIST_HEAD(&p->list);sus_path_index_add(p);list_add_tail(&p->list,&sus_path_list);sus_path_count++;
+                assert(sus_path_release_module_hidden(path)==1 && sus_path_count==1 && find(path)==p);
+                assert(sus_path_path_is_ours(path));assert(sus_path_del_path_impl(path)==1);
+            } else if(!strcmp(name,"module-reload") || !strcmp(name,"module-allocation-failure") || !strcmp(name,"module-capacity")) {
+                files[0].dentry.inode=&files[1].inode;
+                if(!strcmp(name,"module-allocation-failure")) {
+                    fail_alloc_at=allocation_calls+1;
+                    assert(sus_path_sync_module_hidden(path)==-ENOMEM);
+                    assert(find(path)==owned && atomic_load(&files[0].inode.refs)==2 && atomic_load(&files[1].inode.refs)==1);
+                    fail_alloc_at=0;
+                }
+                if(!strcmp(name,"module-capacity"))sus_path_count=SUS_PATH_MAX_ENTRIES;
+                assert(sus_path_sync_module_hidden(path)==1);
+                assert(find(path)->inode==&files[1].inode && atomic_load(&files[0].inode.refs)==1);
+                if(!strcmp(name,"module-capacity")) {
+                    files[2].path="/sys/module/other";files[2].tag=worker.tag;files[2].exists=true;
+                    assert(sus_path_sync_module_hidden(files[2].path)==-ENOSPC);
+                    assert(sus_path_count==SUS_PATH_MAX_ENTRIES);sus_path_count=1;
+                }
+            } else if(!strcmp(name,"module-missing")) {
+                assert(!add(path,CMD_SUSFS_ADD_SUS_PATH));files[0].exists=false;
