@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef SUSFS_VISIBILITY_H
+#define SUSFS_VISIBILITY_H
+
+#include <linux/cred.h>
+#include <linux/module.h>
+
+static inline bool susfs_module_name_valid(const char *name, size_t len)
+{
+	size_t i;
+
+	if (!name || !len || len >= MODULE_NAME_LEN ||
+	    (len == 1 && name[0] == '.') ||
+	    (len == 2 && name[0] == '.' && name[1] == '.'))
+		return false;
+	for (i = 0; i < len; i++) {
+		char c = name[i];
+
+		if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') ||
+		      (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.'))
+			return false;
+	}
+	return true;
+}
+
+/* Module discovery uses effective global root. Private control-node
+ * authorization remains a separate check. */
+static inline bool susfs_module_root_reader(void)
+{
+	return uid_eq(current_euid(), GLOBAL_ROOT_UID);
+}
+
+#endif
