+static bool hide_modules_auto_event_locked(const char *name,
+					 enum hide_module_presence presence)
+{
+	int i;
+
+	if (!auto_modules_enabled)
+		return false;
+	for (i = 0; i < n_auto_modules; i++)
+		if (!strcmp(name, auto_modules[i].name))
+			break;
+	if (i == n_auto_modules) {
+		if (presence == HIDE_MODULE_GONE || hide_modules_stock_locked(name))
+			return false;
+		if (i == HIDE_MODULES_AUTO_MAX) {
