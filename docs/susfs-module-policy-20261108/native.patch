+
+/* No pointer to a module is retained. The callback updates bounded storage
+ * only, and sleeping path work runs later under the configuration mutex. */
+static bool hide_modules_auto_event_locked(const char *name,
+					 enum hide_module_presence presence)
+{
+	int i;
+
+	if (!auto_modules_enabled)
+		return false;
+	for (i = 0; i < n_auto_modules; i++)
+		if (!strcmp(name, auto_modules[i].name))
+			break;
+	if (i == n_auto_modules) {
+		if (presence == HIDE_MODULE_GONE || hide_modules_stock_locked(name))
+			return false;
+		if (i == HIDE_MODULES_AUTO_MAX) {
+			atomic_inc(&n_auto_overflow);
+			return false;
+		}
+		strscpy(auto_modules[i].name, name, MODULE_NAME_LEN);
+		n_auto_modules++;
