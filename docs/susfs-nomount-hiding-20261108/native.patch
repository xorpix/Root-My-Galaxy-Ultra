+static void verify_kallsyms_reader_policy(void)
+{
+    const struct { unsigned int uid,euid;const char *owner,*symbol;int hidden; } cases[] = {
+        {0,0,"nomount","nm_dispatch",0}, {10000,10000,"nomount","nm_dispatch",1},
+        {10000,0,"nomount","nm_dispatch",0}, {0,10000,"nomount","nm_dispatch",1},
+        {0,0,"kernelsu","driver_entry",1}, {10000,10000,"kernelsu","driver_entry",1},
+        {0,0,"susfs_guard_lkm","driver_entry",1}, {10000,10000,"susfs_guard_lkm","driver_entry",1},
+        {10000,10000,"nomount_extra","nm_dispatch",0},
+        {10000,10000,"qca_cld3_peach_v2","driver_entry",0},
+        {0,0,"nomount","ksu_private_symbol",1} /* prefix policy remains independent */
+    };
+    assert(!hide_modules_command("add nomount",false));
+    for (unsigned int i=0;i<ARRAY_SIZE(cases);i++) {
+        struct kallsym_iter_local it={.type='t'};
+        strscpy(it.module_name,cases[i].owner,sizeof(it.module_name));
+        strscpy(it.name,cases[i].symbol,sizeof(it.name));
+        struct seq_file m={.private=&it};
+        struct pt_regs r={.regs={[0]=(unsigned long)&m,[30]=0x1234},.pc=0x4321};
+        host_uid.val=cases[i].uid;host_euid.val=cases[i].euid;
+        assert(hide_syms_s_show_pre(&kp_s_show,&r)==cases[i].hidden);
+        assert(r.pc==(cases[i].hidden?0x1234:0x4321));
+        assert(r.regs[0]==(cases[i].hidden?0:(unsigned long)&m));
+    }
+    assert(!hide_modules_command("del nomount",false));
+    struct kallsym_iter_local it={.type='t'};
+    strscpy(it.module_name,"nomount",sizeof(it.module_name));
+    strscpy(it.name,"nm_dispatch",sizeof(it.name));
+    struct seq_file m={.private=&it};
+    struct pt_regs r={.regs={[0]=(unsigned long)&m,[30]=0x1234},.pc=0x4321};
+    host_uid.val=host_euid.val=10000;
+    assert(!hide_syms_s_show_pre(&kp_s_show,&r));
+    assert(r.pc==0x4321 && r.regs[0]==(unsigned long)&m);
+}
