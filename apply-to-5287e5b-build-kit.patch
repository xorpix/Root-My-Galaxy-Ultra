++/// Moves an already-staged copy onto the daemon path.
++///
++/// The staged file is on the same filesystem, so the move is a rename: the destination either has the
++/// whole new daemon or the old one, and never a truncated file. Ownership and mode are set here
++/// because the copy arrived from a staging directory this app chose.
++pub fn stage_daemon_from(staged_exe: impl AsRef<Path>) -> Result<()> {
++    ensure_dir_exists(defs::ADB_DIR)?;
++
++    std::fs::rename(staged_exe.as_ref(), defs::DAEMON_PATH).with_context(|| {
++        format!(
++            "Failed to rename {} to {}",
++            staged_exe.as_ref().display(),
++            defs::DAEMON_PATH
++        )
++    })?;
++    chown(defs::DAEMON_PATH, Some(Uid::ROOT), Some(Gid::ROOT))?;
++    #[cfg(unix)]
